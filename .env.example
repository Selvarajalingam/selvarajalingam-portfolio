# Contact remains disabled until domain, providers and firewall are verified.
CONTACT_ENABLED=false
CONTACT_SENDER_VERIFIED=false
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
# Exact @vercel/firewall rate-limit rule ID; configure the rule in Vercel first.
CONTACT_RATE_LIMIT_ID=
# Optional paired risk-based CAPTCHA configuration. Never expose the secret.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Set only after the deployment origin has been confirmed.
# Exact https:// origin, with no trailing slash/path. Allow one origin per deployment.
SITE_URL=
# Optional public GitHub snapshots. Static curated links work when disabled.
GITHUB_METADATA_ENABLED=true
# Optional server-only, read-only public metadata token. No private scopes needed.
GITHUB_TOKEN=
