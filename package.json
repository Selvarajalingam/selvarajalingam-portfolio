{
  "name": "selvarajalingam-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "npm run content:validate && next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "content:validate": "tsx scripts/validate-content.ts",
    "perf:bundles": "tsx scripts/report-bundles.ts",
    "links:projects": "tsx scripts/check-project-links.ts",
    "links:ventures": "tsx scripts/check-venture-links.ts",
    "github:verify": "node --conditions=react-server --import tsx scripts/check-github.ts",
    "assets:og": "tsx scripts/generate-og.tsx",
    "seo:validate": "tsx scripts/validate-seo.ts",
    "artifacts:validate": "tsx scripts/check-artifacts.ts",
    "links:all": "tsx scripts/check-external-links.ts",
    "test:audit": "playwright test --config=playwright.audit.config.ts",
    "deploy:smoke": "tsx scripts/check-deployment.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@vercel/analytics": "2.0.1",
    "@vercel/firewall": "1.2.6",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remark-parse": "11.0.0",
    "server-only": "0.0.1",
    "three": "0.187.0",
    "unified": "11.0.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@types/jsdom": "30.0.0",
    "@types/mdast": "4.0.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "jsdom": "29.1.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
